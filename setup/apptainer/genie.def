# Apptainer definition for the GENIE neutrino event generator on Linux x86_64.
# Hand-translated from setup/Dockerfile.genie — UPDATE BOTH TOGETHER.
# Differences from the Dockerfile (divergence is deliberate, see
# docs/design_decisions.md):
#   * No --platform pinning: cluster builds run on native x86_64.
#   * The runtime stage additionally installs the neutrino-factory Python
#     runtime dependencies, because on the cluster the Slurm task runs the CLI
#     *inside* this image (Apptainer cannot nest containers).
#
# Build (on odslserv01/02, NOT the Slurm head node):
#   apptainer build --build-arg JOBS=32 \
#     "$NF_IMAGE_ROOT/genie_R-3_06_00.sif" setup/apptainer/genie.def
#
# ROOT 6.24.08 is used intentionally: it includes native TPythia6/libEGPythia6
# and has TXMLEngine::GetAttr() returning "" for missing attributes. ROOT 6.26+
# changed GetAttr() to return nullptr, which crashes GENIE R-3_06_00's
# AlgConfigPool::LoadRegistries.

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
Bootstrap: docker
From: ubuntu:22.04
Stage: builder

%arguments
    GENIE_TAG=R-3_06_00
    LHAPDF_VERSION=6.5.6
    ROOT_VERSION=6.24.08
    PYTHIA6_VERSION=6.4.28
    JOBS=4

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        cmake \
        git \
        curl \
        ca-certificates \
        libgsl-dev \
        libxml2-dev \
        liblog4cpp5-dev \
        libfreetype6-dev \
        libpcre3-dev \
        libssl-dev \
        python3-dev \
        python3 \
        python-is-python3 \
        perl \
        xz-utils \
        && rm -rf /var/lib/apt/lists/*

    # ── GENIE source ──────────────────────────────────────────────────────────
    # Clone straight into the final location and build in place. GENIE resolves
    # its tunes (config/) and physics data (data/) from $GENIE at runtime; a
    # relocating --prefix install of GENIE R-3 is fragile and drops the data/
    # tree, so we keep $GENIE pointing at the build tree.
    git clone --depth 1 --branch "{{ GENIE_TAG }}" \
        https://github.com/GENIE-MC/Generator.git /opt/genie

    # ── Pythia6 (GENIE's own upstream build script) ───────────────────────────
    # pythia.org now 302-redirects the Fortran source to pythia8.web.cern.ch,
    # but the script fetches with `curl -f -O` (no -L) and silently saves the
    # 85-byte redirect page — libPythia6.so then lacks pyevnt_ etc. and the
    # ROOT libEGPythia6 link fails. Pre-stage the file where the script looks
    # (<topdir>/download/<basef>_with_dummies) so it skips its own fetch.
    PY6_MAJ="$(echo "{{ PYTHIA6_VERSION }}" | cut -d. -f1)"
    PY6_MIN="$(echo "{{ PYTHIA6_VERSION }}" | cut -d. -f2)"
    PY6_TINY="$(echo "{{ PYTHIA6_VERSION }}" | cut -d. -f3)"
    PY6_DL="/opt/pythia6/v${PY6_MAJ}_${PY6_MIN}${PY6_TINY}/download"
    mkdir -p "${PY6_DL}"
    curl -fsSL \
        "https://pythia.org/download/pythia6/pythia${PY6_MAJ}${PY6_MIN}${PY6_TINY}.f" \
        -o "${PY6_DL}/pythia${PY6_MAJ}${PY6_MIN}${PY6_TINY}.f_with_dummies"
    cd /opt/pythia6
    bash /opt/genie/src/scripts/build/ext/build_pythia6.sh "{{ PYTHIA6_VERSION }}"
    test -s "$(find /opt/pythia6 -maxdepth 4 -name 'libPythia6.so' | head -1)"

    # ── LHAPDF ────────────────────────────────────────────────────────────────
    curl -fsSL \
        "https://lhapdf.hepforge.org/downloads/LHAPDF-{{ LHAPDF_VERSION }}.tar.gz" \
        -o /tmp/lhapdf.tar.gz
    tar -xzf /tmp/lhapdf.tar.gz -C /tmp
    cd "/tmp/LHAPDF-{{ LHAPDF_VERSION }}"
    ./configure --prefix=/opt/lhapdf6 --disable-pyext
    make -j"{{ JOBS }}"
    make install
    # %post is one continuous shell (unlike Dockerfile RUN steps): leave the
    # build dir before deleting it, or every later command runs from a deleted
    # cwd and cmake aborts with "Current working directory cannot be established".
    cd /
    rm -rf "/tmp/LHAPDF-{{ LHAPDF_VERSION }}" /tmp/lhapdf.tar.gz

    # ── ROOT ──────────────────────────────────────────────────────────────────
    # Pythia6 detection: ROOT's FindPythia6 honours PYTHIA6_DIR (parent of lib/)
    # and requires an include anchor named general_pythia.inc, which GENIE's
    # build_pythia6.sh does not produce — create it, or ROOT silently disables
    # pythia6 and GENIE breaks.
    # -Dimt=OFF / -Dclad=OFF are kept from the Docker build (harmless natively,
    # required under amd64 emulation) so both images run identical physics code.
    PYTHIA6_LIBDIR="$(find /opt/pythia6 -maxdepth 4 -name 'libPythia6.so' \
        -exec dirname {} \; | head -1)"
    PYTHIA6_DIR="$(dirname "${PYTHIA6_LIBDIR}")"
    touch "${PYTHIA6_DIR}/inc/general_pythia.inc"
    curl -fsSL \
        "https://root.cern/download/root_v{{ ROOT_VERSION }}.source.tar.gz" \
        -o /tmp/root-src.tar.gz
    tar -xzf /tmp/root-src.tar.gz -C /tmp
    mv "/tmp/root-{{ ROOT_VERSION }}" /tmp/root-src
    cmake -S /tmp/root-src -B /tmp/root-build \
        -DCMAKE_INSTALL_PREFIX=/opt/root \
        -DCMAKE_BUILD_TYPE=Release \
        -Dpythia6=ON \
        -DPYTHIA6_DIR="${PYTHIA6_DIR}" \
        -DPYTHIA6_LIBRARY="${PYTHIA6_LIBDIR}/libPythia6.so" \
        -Dmathmore=ON \
        -Dimt=OFF \
        -Dclad=OFF \
        -Ddavix=OFF \
        -Dxrootd=OFF \
        -Dwebgui=OFF \
        -Dasimage=OFF \
        -Dopengl=OFF \
        -Dx11=OFF \
        -Dgviz=OFF \
        -Dbuiltin_freetype=OFF \
        -Dbuiltin_pcre=OFF \
        -Dbuiltin_openssl=OFF \
        -Dcxxmodules=OFF \
        -Wno-dev
    cmake --build /tmp/root-build --parallel "{{ JOBS }}"
    cmake --install /tmp/root-build
    test -f /opt/root/lib/libEGPythia6.so
    rm -rf /tmp/root-src /tmp/root-build /tmp/root-src.tar.gz

    # ── GENIE ─────────────────────────────────────────────────────────────────
    # Build in place at $GENIE=/opt/genie (no relocating --prefix). Set ROOT env
    # explicitly instead of sourcing thisroot.sh (bash-only; %post runs in sh).
    PYTHIA6_LIBDIR="$(find /opt/pythia6 -maxdepth 4 -name 'libPythia6.so' \
        -exec dirname {} \; | head -1)"
    export ROOTSYS=/opt/root
    export PATH="/opt/root/bin:${PATH}"
    export LD_LIBRARY_PATH="/opt/root/lib:/opt/lhapdf6/lib:${PYTHIA6_LIBDIR}"
    export GENIE=/opt/genie
    cd /opt/genie
    ./configure \
        --disable-lhapdf5 \
        --enable-lhapdf6 \
        --enable-pythia6 \
        --disable-pythia8 \
        --with-lhapdf6-inc=/opt/lhapdf6/include \
        --with-lhapdf6-lib=/opt/lhapdf6/lib \
        --with-libxml2-inc=/usr/include/libxml2 \
        --with-libxml2-lib=/usr/lib/x86_64-linux-gnu \
        --with-log4cpp-inc=/usr/include \
        --with-log4cpp-lib=/usr/lib/x86_64-linux-gnu \
        --with-pythia6-lib="${PYTHIA6_LIBDIR}"
    make -j"{{ JOBS }}"
    test -d /opt/genie/config && test -d /opt/genie/data
    test -x /opt/genie/bin/gevgen

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
Bootstrap: docker
From: ubuntu:22.04
Stage: final

# Defaults must be redeclared per stage; {{ }} placeholders below need them.
%arguments
    GENIE_TAG=R-3_06_00
    ROOT_VERSION=6.24.08

%files from builder
    /opt/root /opt/root
    /opt/genie /opt/genie
    /opt/lhapdf6 /opt/lhapdf6
    /opt/pythia6 /opt/pythia6

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        libgsl27 \
        libxml2 \
        liblog4cpp5v5 \
        libssl3 \
        libfreetype6 \
        libpcre3 \
        python3 \
        python3-pip \
        libgomp1 \
        perl \
        libgfortran5 \
        g++ \
        && rm -rf /var/lib/apt/lists/*

    # neutrino-factory runtime deps: the Slurm task runs the CLI inside this
    # image (Apptainer cannot nest). Mirrors pyproject.toml [project.dependencies].
    pip3 install --no-cache-dir \
        "PyYAML>=6.0" \
        "h5py>=3.10" \
        "numpy>=1.24" \
        "uproot>=5.0" \
        "awkward>=2.0" \
        "matplotlib>=3.7"

    # Pythia6 lib path is version-specific; register it with ldconfig so
    # non-interactive runs can load libPythia6.so.
    PYTHIA6_LIBDIR="$(find /opt/pythia6 -maxdepth 4 -name 'libPythia6.so' \
        -exec dirname {} \; | head -1)"
    printf '%s\n' "${PYTHIA6_LIBDIR}" > /etc/ld.so.conf.d/pythia6.conf
    printf '%s\n' /opt/genie/lib /opt/root/lib /opt/lhapdf6/lib \
        > /etc/ld.so.conf.d/genie.conf
    ldconfig

%environment
    export GENIE=/opt/genie
    export ROOTSYS=/opt/root
    export PATH=/opt/genie/bin:/opt/root/bin:$PATH
    export LD_LIBRARY_PATH=/opt/genie/lib:/opt/root/lib:/opt/lhapdf6/lib

%test
    test -x /opt/genie/bin/gevgen
    python3 -c "import yaml, h5py, numpy, uproot, awkward"

%labels
    org.neutrino-factory.image genie
    org.neutrino-factory.source setup/Dockerfile.genie

%help
    GENIE {{ GENIE_TAG }} with ROOT {{ ROOT_VERSION }}, LHAPDF6, Pythia6, and
    the neutrino-factory Python runtime. gevgen and gntpc are on $PATH.
