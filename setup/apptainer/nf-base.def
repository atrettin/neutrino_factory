# Static tail of the composed nf-base definition: Python runtime + a generic,
# generator-agnostic dispatcher. It contains NO generator names.
#
# build_apptainer_images.sh generates the variable-length head — one
#   Bootstrap: localimage / From: <payload sif> / Stage: payload_<n>
# per discovered payload SIF, then the final python:3.13-slim stage, then one
#   %files from payload_<n>
#     /opt/nf/generators/<gen>/<code_version> /opt/nf/generators/<gen>/<code_version>
# block per payload — and concatenates this file after it. Adding a generator or
# a new version therefore needs NO edit here: build the payload SIF and recompose.
#
# All per-generator PATH/LD_LIBRARY_PATH/run logic now lives in each payload's
# shipped bin/<binary> wrappers (setup/apptainer/<gen>.def); this image only
# installs the `nf-run` dispatcher and descriptor-driven default-version symlinks.

%post
    export DEBIAN_FRONTEND=noninteractive
    # Fixed, generator-agnostic runtime baseline: the union of *system* shared
    # libraries the payloads link against. Payloads bundle their own component
    # trees under /opt/nf/generators (ROOT, GENIE, etc.), but the base C/Fortran
    # and common scientific runtimes come from system packages here — the
    # payloads' own apt-installed libs live in their image's /usr/lib and are NOT
    # copied into this composed image. When a new generator/version needs a
    # system lib not listed here, add it (a fixed union is simpler than trying to
    # derive it per payload).
    # NOTE: nf-base is pinned to Debian bookworm (see build_apptainer_images.sh)
    # so these SONAMEs match the Ubuntu-22.04 payload binaries — libgsl27 gives
    # libgsl.so.27/libgslcblas.so.0, not trixie's libgsl.so.28. `libgsl27`
    # provides both libgsl and libgslcblas.
    apt-get update && apt-get install -y --no-install-recommends \
        libgfortran5 \
        libgomp1 \
        libfreetype6 \
        g++ \
        libgsl27 \
        libgslcblas0 \
        libxml2 \
        liblog4cpp5v5 \
        libssl3 \
        libnsl2 \
        perl \
        && (apt-get install -y --no-install-recommends libpcre3 || apt-get install -y --no-install-recommends libpcre3t64) \
        && rm -rf /var/lib/apt/lists/* \
        || { echo "nf-base: baseline apt install failed (a package name may not resolve on this base image)" >&2; exit 1; }

    pip install --no-cache-dir \
        "PyYAML>=6.0" \
        "h5py>=3.10" \
        "numpy>=1.24" \
        "uproot>=5.0" \
        "awkward>=2.0" \
        "matplotlib>=3.7"

    mkdir -p /usr/local/bin

    # Generic version-aware dispatcher. Resolves the payload for
    # `<generator> <code_version>` and execs the wrapper that payload ships.
    # Applies the same filesystem-safe transform to <code_version> that payload
    # staging uses, so the arg and the on-disk directory never diverge.
    cat > /usr/local/bin/nf-run <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if (( $# < 3 )); then
    echo "usage: nf-run <generator> <code_version> <binary> [args...]" >&2
    exit 2
fi
gen="$1"; cv="$2"; bin="$3"; shift 3
cv_safe="$(printf '%s' "$cv" | sed 's/[^A-Za-z0-9._-]/_/g')"
wrapper="/opt/nf/generators/$gen/$cv_safe/bin/$bin"
if [[ ! -x "$wrapper" ]]; then
    echo "nf-run: no payload wrapper at $wrapper" >&2
    echo "nf-run: composed payloads:" >&2
    ls -1d /opt/nf/generators/*/*/ 2>/dev/null >&2 || true
    exit 127
fi
exec "$wrapper" "$@"
EOF
    chmod +x /usr/local/bin/nf-run

    # Descriptor-driven default-version convenience symlinks. For each generator,
    # the highest (sorted-last) composed code_version provides the bare binary
    # names on $PATH. This keeps interactive use (`gevgen`) working and keeps the
    # adapters' native-binary-first probe (shutil.which) unchanged; any specific
    # version is always reachable via `nf-run <gen> <cv> <bin>`.
    for gen_dir in /opt/nf/generators/*/; do
        [ -d "$gen_dir" ] || continue
        gen="$(basename "$gen_dir")"
        default_cv=""
        for cv_name in $(ls -1 "$gen_dir" 2>/dev/null | sort); do
            [ -f "$gen_dir$cv_name/nf-payload.json" ] && default_cv="$cv_name"
        done
        [ -n "$default_cv" ] || continue
        for wrapper in "$gen_dir$default_cv/bin/"*; do
            [ -x "$wrapper" ] || continue
            bname="$(basename "$wrapper")"
            cat > "/usr/local/bin/$bname" <<EOF
#!/usr/bin/env bash
exec nf-run "$gen" "$default_cv" "$bname" "\$@"
EOF
            chmod +x "/usr/local/bin/$bname"
        done
    done

%test
    python3 -c "import yaml, h5py, numpy, uproot, awkward, matplotlib"
    command -v nf-run

%labels
    org.neutrino-factory.image nf-base

%help
    Unified neutrino-factory runtime image (Python + generator payloads).
    Enter once (e.g. via cenv) and run neutrino-factory or generator binaries
    directly. Bare binary names (gevgen, nuwro, GiBUU.x) run the default version;
    a specific version is reached with: nf-run <generator> <code_version> <bin>.
